---
import type { MarkdownLayoutProps } from "astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "./Layout.astro";
import { SITE } from "@/config";
import { SCHEMA_IDS, personSchema } from "@/utils/schema";

type Props = MarkdownLayoutProps<{
  title: string;
  description?: string;
  /** Le markdown porte déjà son propre `# Titre` (ex. CV). */
  hideTitle?: boolean;
}>;

const { frontmatter } = Astro.props;
const { title, description, hideTitle = false } = frontmatter;

// ProfilePage ne décrit que la page À propos : l'émettre sur le CV, le
// contact ou la politique de confidentialité les faisait passer pour /about/.
const isProfilePage = Astro.url.pathname.replace(/\/$/, "") === "/about";
---

<Layout title={`${title} | ${SITE.title}`} description={description}>
  {
    isProfilePage && (
      <script
        slot="head"
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "ProfilePage",
          url: `${SITE.website}about/`,
          inLanguage: "fr",
          isPartOf: { "@id": SCHEMA_IDS.website },
          mainEntity: {
            ...personSchema,
            worksFor: { "@id": SCHEMA_IDS.organization },
          },
        })}
      />
    )
  }
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-20">
    {
      !hideTitle && (
        <header class="page-header">
          <h1 class="text-4xl leading-[1.08] font-semibold tracking-[-0.03em] sm:text-5xl">
            {title}
          </h1>
          {description && (
            <p class="mt-4 max-w-2xl text-lg leading-relaxed text-soft">
              {description}
            </p>
          )}
        </header>
      )
    }

    <section
      id="about"
      class:list={["page-content app-prose max-w-app", { "pt-6": hideTitle }]}
    >
      <slot />
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-header {
    padding-block: 1.5rem 2.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  /* Pages dont le markdown porte son h1 (CV) : même échelle que les autres. */
  .page-content :global(h1) {
    font-size: clamp(2.25rem, 5vw, 3rem);
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
  }

  /* Le premier h2 du corps n'a pas besoin de la grande marge haute. */
  .page-content > :global(h2:first-child) {
    margin-top: 0;
  }
</style>
