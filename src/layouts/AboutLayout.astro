---
import type { MarkdownLayoutProps } from "astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "./Layout.astro";
import { SITE } from "@/config";

type Props = MarkdownLayoutProps<{ title: string }>;

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: SITE.author,
      url: SITE.website,
      sameAs: [
        "https://github.com/visbran",
      ],
      jobTitle: "Administrateur systèmes et réseaux",
      knowsAbout: ["Homelab", "Auto-hébergement", "Linux", "Proxmox", "Docker", "Réseaux", "Sécurité informatique", "macOS"],
      worksFor: {
        "@type": "Organization",
        name: SITE.title,
        url: SITE.website,
      },
    })}
  />
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout">
    <div class="about-hero">
      <div class="hero-content">
        <div class="avatar-ring">
          <div class="avatar-inner">
            <span class="avatar-emoji">👨‍💻</span>
          </div>
        </div>
        <h1 class="hero-title">
          <span class="greeting">Salut, je suis</span>
          <span class="name-glow">{SITE.author}</span>
        </h1>
        <div class="hero-badges">
          <span class="badge">🖥️ Homelab</span>
          <span class="badge">🐧 Linux</span>
          <span class="badge">☁️ Auto-hébergement</span>
        </div>
      </div>
    </div>

    <section
      id="about"
      class="about-content app-prose mb-28 max-w-app prose-img:border-0"
    >
      <slot />
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .about-hero {
    position: relative;
    overflow: hidden;
    border-radius: 1.5rem;
    padding: 3rem 2rem;
    margin-bottom: 3rem;
    background: color-mix(
      in srgb,
      var(--color-foreground) 3%,
      var(--color-background)
    );
    border: 1px solid color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  .hero-content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
  }

  /* Avatar */
  .avatar-ring {
    position: relative;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    padding: 3px;
    background: color-mix(in srgb, var(--color-accent) 35%, var(--color-border));
  }

  .avatar-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--color-background);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avatar-emoji {
    font-size: 2.75rem;
    line-height: 1;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .greeting {
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-foreground);
    opacity: 0.7;
  }

  .name-glow {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-foreground);
  }

  @media (min-width: 640px) {
    .name-glow {
      font-size: 2.75rem;
    }
  }

  /* Badges */
  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .badge {
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-foreground);
    background: color-mix(
      in srgb,
      var(--color-foreground) 4%,
      var(--color-background)
    );
    border: 1px solid color-mix(in srgb, var(--color-accent) 15%, transparent);
    transition:
      transform 0.25s cubic-bezier(0.25, 1, 0.5, 1),
      border-color 0.25s ease;
    cursor: default;
  }

  .badge:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .badge {
      transition: none;
    }

    .badge:hover {
      transform: none;
    }
  }

  /* Content styling */
  .about-content {
    position: relative;
  }

  .about-content :global(h2) {
    position: relative;
    display: inline-block;
  }

  .about-content :global(h2::after) {
    content: "";
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent), transparent);
    border-radius: 999px;
  }
</style>
