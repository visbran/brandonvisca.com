---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import GalleryEmbed from "@/components/GalleryEmbed.astro";
import { getPath } from "@/utils/getPath";
import tagsVocabulary from "@/data/tags.json";
import { slugifyStr } from "@/utils/slugify";
import { SITE } from "@/config";
import { SCHEMA_IDS, organizationSchema, personSchema } from "@/utils/schema";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
  faqs,
} = post.data;

const { Content, headings } = await render(post);

// FAQ du frontmatter affichée sous l'article : le JSON-LD FAQPage doit décrire
// un contenu visible. Les 47 articles qui ont déjà une section FAQ rédigée
// dans le corps ne l'affichent pas une seconde fois.
const hasBodyFaq = headings.some(
  h => h.depth === 2 && /\bfaq\b|questions fréquentes|foire aux questions/i.test(h.text)
);
const visibleFaqs = !hasBodyFaq && faqs && faqs.length > 0 ? faqs : [];

// Réponses en texte brut, avec `code` et [lien](url) en ligne comme seul balisage.
const escapeHtml = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const faqAnswerHtml = (s: string) =>
  escapeHtml(s)
    .replace(/`([^`]+)`/g, "<code>$1</code>")
    .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2">$1</a>');

// « Brandon », « brandon » et « Brandon Visca » désignent tous l'auteur du site.
const isSiteAuthor =
  !author || SITE.author.toLowerCase().startsWith(author.toLowerCase());

/* ========== Lecture : sommaire latéral + temps de lecture ========== */
// Le sommaire inline (remark-toc, « Table des matières ») reste dans le corps
// pour les écrans étroits ; le rail latéral reprend les h2/h3 sans lui.
const TOC_HEADING = "Table des matières";
const tocItems = headings.filter(
  h => (h.depth === 2 || h.depth === 3) && h.text !== TOC_HEADING
);
const words = (post.body ?? "")
  .replace(/```[\s\S]*?```/g, " ")
  .split(/\s+/)
  .filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(words / 230));

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local ogImage
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const layoutProps = {
  title,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
};

/* ========== À lire ensuite : articles proches par tags ========== */

// Remplace la navigation précédent/suivant chronologique. Un tag secondaire
// partagé pèse plus qu'un primaire (il est plus spécifique) ; les méta-tags de
// niveau ne comptent pas. À score égal, le plus récent l'emporte.
const metaTags = new Set(tagsVocabulary.meta);
const primaryTags = new Set(tagsVocabulary.primary);
const topicTags = (list: string[] = []) =>
  list.map(t => slugifyStr(t)).filter(t => !metaTags.has(t));
const currentTags = new Set(topicTags(tags));

const relatedPosts = posts
  .filter(p => p.id !== post.id)
  .map(p => ({
    p,
    score: topicTags(p.data.tags).reduce(
      (sum, t) => sum + (currentTags.has(t) ? (primaryTags.has(t) ? 1 : 3) : 0),
      0
    ),
  }))
  .filter(({ score }) => score > 0)
  .sort(
    (a, b) =>
      b.score - a.score ||
      b.p.data.pubDatetime.valueOf() - a.p.data.pubDatetime.valueOf()
  )
  .slice(0, 2)
  .map(({ p }) => ({ id: p.id, title: p.data.title, filePath: p.filePath }));
---

<Layout {...layoutProps}>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "datePublished": pubDatetime,
      "dateModified": modDatetime || pubDatetime,
      "inLanguage": "fr",
      "license": "https://creativecommons.org/licenses/by-sa/4.0/deed.fr",
      "articleSection": tags?.[0] || "Blog",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalURL || Astro.url.href,
      },
      "isPartOf": { "@id": SCHEMA_IDS.website },
      "author":
        isSiteAuthor
          ? personSchema
          : { "@type": "Person", "name": author },
      "publisher": organizationSchema,
      "url": canonicalURL || Astro.url.href,
      ...(ogImage
        ? {
            "image": {
              "@type": "ImageObject",
              "url": ogImage,
              "width": 1200,
              "height": 630,
            },
          }
        : {}),
    })}
  />
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Accueil",
          "item": Astro.url.origin + "/",
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": title,
          "item": canonicalURL || Astro.url.href,
        },
      ],
    })}
  />
  {faqs && faqs.length > 0 && (
    <script
      slot="head"
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqs.map((faq: { question: string; answer: string }) => ({
          "@type": "Question",
          "name": faq.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.answer,
          },
        })),
      })}
    />
  )}
  <Header />
  {SITE.showBackButton && <Breadcrumb withBackButton currentLabel={title} />}
  <main
    id="main-content"
    class:list={["relative app-layout pb-12", { "mt-8": !SITE.showBackButton }]}
    data-pagefind-body
  >
    <!-- Post header : aligné à gauche, sans boîte. Méta en une ligne mono. -->
    <header class="post-header relative mt-6 mb-10 border-b border-border pb-10 sm:mt-10">
      <h1
        class="post-title max-w-[22ch] text-4xl leading-[1.08] font-semibold tracking-[-0.03em] sm:text-5xl lg:text-[3.25rem]"
      >
        {title}
      </h1>

      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-soft">
        {description}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
        {!isSiteAuthor && (
          <span class="text-foreground">{author}</span>
        )}
        <Datetime
          {pubDatetime}
          {modDatetime}
          {timezone}
          size="lg"
        />
        <span class="font-mono text-xs text-soft sm:text-sm">{readingMinutes} min de lecture</span>
        <ul class="flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs" aria-label="Tags">
          {
            tags.map((tag: string) => (
              <li>
                <a
                  href={`/tags/${slugifyStr(tag)}/`}
                  class="text-soft transition-colors duration-200 hover:text-accent"
                >
                  #{tag}
                </a>
              </li>
            ))
          }
        </ul>
        <EditPost
          {hideEditPost}
          {post}
          class="flex text-soft transition-colors duration-200 hover:text-accent [&>svg]:size-3.5"
        />
      </div>
    </header>

    <div class="post-body">
    <div class="post-column">
    <article
      id="article"
      class="app-prose mt-0 w-full prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    >
      <Content components={{ GalleryEmbed }} />
      {visibleFaqs.length > 0 && (
        <section class="post-faq" aria-labelledby="questions-frequentes">
          <h2 id="questions-frequentes">Questions fréquentes</h2>
          {visibleFaqs.map(faq => (
            <details>
              <summary>{faq.question}</summary>
              <p set:html={faqAnswerHtml(faq.answer)} />
            </details>
          ))}
        </section>
      )}
    </article>

    <div class="mt-16 mb-8 h-px bg-border" aria-hidden="true"></div>

    <!-- Tags & Share row -->
    <div
      class="mt-6 mb-8 flex flex-col items-center gap-6 sm:flex-row sm:items-start sm:justify-between"
    >
      <!-- Tags (duplicated from header, aria-hidden to avoid double indexing) -->
      <div class="flex flex-wrap justify-center gap-x-3 gap-y-1 sm:justify-start" aria-hidden="true">
        {
          tags.map((tag: string) => (
            <a
              href={`/tags/${slugifyStr(tag)}/`}
              tabindex="-1"
              class="font-mono text-xs text-soft transition-colors duration-200 hover:text-accent"
            >
              #{tag}
            </a>
          ))
        }
      </div>

      <!-- Share links -->
      <ShareLinks />
    </div>

    <!-- À lire ensuite : 2 articles proches par tags -->
    {
      relatedPosts.length > 0 && (
        <nav
          data-pagefind-ignore
          aria-labelledby="read-next-title"
          class="mt-10 border-t border-border pt-8"
        >
          <p id="read-next-title" class="font-mono text-xs text-soft">
            À lire ensuite
          </p>
          <ul class="mt-3 grid gap-6 sm:grid-cols-2" role="list">
            {relatedPosts.map(p => (
              <li>
                <a
                  href={getPath(p.id, p.filePath)}
                  class="post-nav-link group block"
                >
                  <span class="line-clamp-2 text-base leading-snug font-semibold text-foreground transition-colors duration-200 group-hover:text-accent">
                    {p.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    </div>
    {
      tocItems.length > 2 && (
        <aside class="toc-rail" aria-labelledby="toc-rail-title" data-pagefind-ignore>
          <p id="toc-rail-title" class="toc-rail-title">Sommaire</p>
          <ol class="toc-rail-list">
            {tocItems.map(h => (
              <li class:list={["toc-rail-item", { "is-sub": h.depth === 3 }]}>
                <a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a>
              </li>
            ))}
          </ol>
        </aside>
      )
    }
    </div>
  </main>
  <BackToTopButton />
  <Footer />
</Layout>

<script is:inline data-astro-rerun>
  /** Create a progress indicator
   *  at the top */
  function createProgressBar() {
    // Guard: avoid duplicating the bar on View Transitions re-runs
    if (document.querySelector(".progress-container")) return;

    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container pointer-events-none fixed top-0 z-50 h-0.5 w-full";

    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-0.5 w-full bg-accent";
    progressBar.id = "myBar";

    progressContainer.appendChild(progressBar);
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  // La progression est pilotée en CSS (animation-timeline: scroll(), voir
  // global.css) : plus d'écouteur `scroll` ni d'écriture de style par frame.

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("h2, h3, h4, h5, h6")
    );
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      link.ariaLabel = "link to heading";
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    const copyButtonLabel = "Copier";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    // Pass 1: read all computed styles before touching the DOM
    // (avoids a forced reflow on every iteration of the loop)
    const topClasses = codeBlocks.map(cb =>
      getComputedStyle(cb).getPropertyValue("--file-name-offset").trim() !== ""
        ? "top-(--file-name-offset)"
        : "-top-3"
    );

    // Pass 2: mutate DOM
    codeBlocks.forEach((codeBlock, i) => {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-3 ${topClasses[i]} rounded-(--radius-inline) bg-surface border border-border px-2 py-1 font-mono text-[0.6875rem] leading-4 text-soft transition-colors hover:text-accent hover:border-accent`;
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      // wrap codeblock with relative parent element
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    });

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      // visual feedback that task is completed
      button.innerText = "Copié";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  /* Go to page start after page swap */
  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );
</script>

<script>
  // Sommaire latéral : section courante surlignée (IntersectionObserver, pas
  // d'écouteur scroll). Le rail est sticky : il s'arrête avec la colonne.
  let tocCleanup: (() => void) | null = null;

  function setupTocRail() {
    tocCleanup?.();
    const rail = document.querySelector<HTMLElement>(".toc-rail");
    const article = document.getElementById("article");
    if (!rail || !article) return;

    const links = new Map<string, HTMLAnchorElement>();
    rail.querySelectorAll<HTMLAnchorElement>("[data-toc-link]").forEach(a => {
      links.set(a.dataset.tocLink ?? "", a);
    });
    const headings = Array.from(links.keys())
      .map(id => document.getElementById(id))
      .filter((h): h is HTMLElement => h !== null);

    const setActive = (id: string) => {
      links.forEach((a, key) => {
        const on = key === id;
        a.classList.toggle("is-active", on);
        if (on) a.setAttribute("aria-current", "location");
        else a.removeAttribute("aria-current");
      });
    };

    // Bande de lecture : du haut (sous le header) au tiers supérieur.
    const visible = new Set<string>();
    const headingObserver = new IntersectionObserver(
      entries => {
        for (const e of entries) {
          if (e.isIntersecting) visible.add(e.target.id);
          else visible.delete(e.target.id);
        }
        const firstVisible = headings.find(h => visible.has(h.id));
        if (firstVisible) {
          setActive(firstVisible.id);
          return;
        }
        // Aucun titre dans la bande : le dernier passé au-dessus reste actif.
        const above = headings.filter(h => h.getBoundingClientRect().top < 0);
        if (above.length) setActive(above[above.length - 1].id);
      },
      { rootMargin: "-80px 0px -66% 0px" }
    );
    headings.forEach(h => headingObserver.observe(h));

    tocCleanup = () => {
      headingObserver.disconnect();
    };
  }

  document.addEventListener("astro:page-load", setupTocRail);
</script>

<style>
  .post-title {
    color: var(--foreground);
  }

  /* ── Colonne de lecture + rail de sommaire ──
   * La colonne est limitée à ~70 caractères (mesure de lecture) et reste
   * calée à gauche, sur le bord du logo et du titre. À partir de 1280px le
   * sommaire occupe l'espace libéré à droite, collant pendant la lecture ;
   * en dessous, le sommaire inline de remark-toc prend le relais. */
  .post-column {
    min-width: 0;
    max-width: 70ch;
  }

  .post-column :global(#article) {
    max-width: none;
  }

  .toc-rail {
    display: none;
  }

  @media (min-width: 1280px) {
    .post-body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 13.5rem;
      gap: 3.5rem;
      align-items: start;
    }

    .toc-rail {
      position: sticky;
      top: 6rem;
      max-height: calc(100dvh - 8rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: none;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding-top: 0.25rem;
    }

    /* Le rail remplace le sommaire inline : on masque son titre et son bloc. */
    :global(#article h2#table-des-matières),
    :global(#article h2#table-des-matières + details) {
      display: none;
    }
  }

  .toc-rail-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--foreground);
  }

  .toc-rail-list {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--border);
  }

  .toc-rail-item a {
    display: block;
    margin-left: -1px;
    padding: 0.3rem 0 0.3rem 0.875rem;
    border-left: 2px solid transparent;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--text-soft);
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .toc-rail-item.is-sub a {
    padding-left: 1.625rem;
    font-size: 0.78rem;
  }

  .toc-rail-item a:hover {
    color: var(--foreground);
  }

  .toc-rail-item a.is-active {
    color: var(--accent);
    border-left-color: var(--accent);
    font-weight: 500;
  }

  .post-nav-link {
    background: color-mix(in srgb, var(--muted) 5%, transparent);
    position: relative;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease, border-color 0.3s ease, background-color 0.3s ease;
  }

  .post-nav-link:hover {
    background: color-mix(in srgb, var(--accent) 4%, transparent);
    transform: translateY(-2px);
  }

  .post-nav-link:active {
    transform: translateY(0) scale(0.98);
  }

</style>
