---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getEntryPath } from "@/utils/contentEntry";
import Datetime from "./Datetime.astro";
import IconGallery from "@/assets/icons/IconGallery.svg";

type Props = {
  variant?: "h2" | "h3";
  featured?: boolean;
} & (CollectionEntry<"blog"> | CollectionEntry<"galleries">);

const { variant: Heading = "h2", featured = false, id, data, filePath, collection } = Astro.props;

const { title, description, pubDatetime } = data;
const modDatetime = "modDatetime" in data ? data.modDatetime : null;
const timezone = "timezone" in data ? data.timezone : undefined;
const href = getEntryPath({ collection, id, filePath });
const isGallery = collection === "galleries";
const headingId = `${collection}-${slugifyStr(String(id))}-title`;
const descriptionId = `${collection}-${slugifyStr(String(id))}-description`;

---

<li
  class:list={[
    "group/card relative my-0 flex flex-col border-t pt-5 pb-6",
    "transition-colors duration-300",
    // Single-ink rule: featured differs by rule weight, not by box or hue
    featured ? "border-accent" : "border-border",
  ]}
>
  <a
    href={href}
    class="text-lg leading-snug font-semibold tracking-[-0.01em] text-foreground transition-colors duration-200 group-hover/card:text-accent focus-visible:outline-none"
    aria-labelledby={headingId}
    aria-describedby={descriptionId}
  >
    <Heading id={headingId} class="flex items-start gap-2">
      {isGallery && (
        <span aria-hidden="true" class="mt-0.5 inline-flex text-accent">
          <IconGallery class="size-4" />
        </span>
      )}
      {isGallery && <span class="sr-only">Gallery:</span>}
      {title}
    </Heading>
    <!-- Whole card is clickable; focus ring drawn on the card itself -->
    <span class="card-hit absolute inset-0 z-10 rounded-(--radius-inline)" aria-hidden="true"></span>
  </a>

  <p
    id={descriptionId}
    class="relative z-20 mt-2 line-clamp-2 text-[0.95rem] leading-relaxed text-soft pointer-events-none"
  >
    {description}
  </p>

  <Datetime pubDatetime={pubDatetime} modDatetime={modDatetime} timezone={timezone} class="relative z-20 mt-auto pt-4 pointer-events-none" />
</li>

<style>
  a:focus-visible .card-hit {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
</style>
