---
import type { HTMLAttributes } from "astro/types";
import { SOCIALS } from "@/constants";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";
const currentYear = new Date().getFullYear();
const socialHeadingId = "footer-social-heading";

const socialLinks = SOCIALS.map(social => ({
  ...social,
  isExternal: /^https?:\/\//.test(social.href),
}));

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["footer-wrapper", { "mt-auto": !noMarginTop }, className]}
  role="contentinfo"
  {...attrs}
>
  <div class="app-layout">
  <div class="border-t border-border py-10 sm:py-12">
    <div class="grid gap-8 sm:grid-cols-[1fr_auto] sm:items-start">
      <div>
        <a
          href="/"
          aria-label={`Accueil de ${SITE.title}`}
          class="footer-home-link text-lg font-semibold tracking-[-0.02em] text-foreground transition-colors hover:text-accent"
        >
          {SITE.title}
        </a>
        <p class="mt-2 max-w-sm text-sm leading-relaxed text-soft">
          Guides concrets sur le homelab, l'auto-hébergement, Linux et macOS.
        </p>
      </div>

      <nav aria-labelledby={socialHeadingId}>
        <p id={socialHeadingId} class="sr-only">Liens</p>
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm" role="list">
          {
            socialLinks.map(social => (
              <li>
                <LinkButton
                  href={social.href}
                  target={social.isExternal ? "_blank" : undefined}
                  rel={social.isExternal ? "noopener noreferrer" : undefined}
                  title={social.linkTitle}
                  class="footer-link inline-flex items-center gap-1.5"
                >
                  <social.icon class="size-4 fill-transparent stroke-current stroke-[1.75px]" aria-hidden="true" />
                  {social.name}
                  <span class="sr-only">: {social.linkTitle}</span>
                </LinkButton>
              </li>
            ))
          }
          <li>
            <a href="/rss.xml" class="footer-link">RSS</a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="mt-10 flex flex-col gap-2 font-mono text-xs text-soft sm:flex-row sm:justify-between">
      <p>
        &copy; {currentYear} {SITE.title}.
        <a href="/politique-confidentialite/" class="footer-link ml-1">Politique de confidentialité</a>
      </p>
      <p>
        Thème dérivé de <a href="https://github.com/0xdres/astro-devosfera" target="_blank" rel="noopener noreferrer" class="footer-link">astro-devosfera</a> par 0xdres
      </p>
    </div>
  </div>
  </div>
</footer>

<style>
  .footer-wrapper {
    position: relative;
    isolation: isolate;
  }

  .footer-link {
    color: var(--text-soft);
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--accent);
  }
</style>
