---
/**
 * ShareLinks — Renders social media share buttons for the current page (e.g. inside a post).
 * Retrieves the available platforms from the SHARE_LINKS constant in `constants.ts`.
 */
import { SHARE_LINKS } from "@/constants";
import LinkButton from "./LinkButton.astro";

const URL = Astro.url;
---

{
  SHARE_LINKS.length > 0 && (
    <div class="flex shrink-0 flex-col items-center gap-2 sm:items-end">
      <span class="font-mono text-xs text-soft select-none">
        Share
      </span>
      <div class="flex items-center gap-1">
        {SHARE_LINKS.map(social => (
          <LinkButton
            href={`${social.href + URL}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-btn inline-flex size-8 items-center justify-center rounded-(--radius-box) border border-border text-soft transition-colors duration-200 hover:border-accent hover:text-accent active:translate-y-px"
            title={social.linkTitle}
          >
            <social.icon class="size-4 fill-transparent stroke-current stroke-2" />
            <span class="sr-only">{social.linkTitle}</span>
          </LinkButton>
        ))}
      </div>
    </div>
  )
}
