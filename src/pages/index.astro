---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getEntryPath } from "@/utils/contentEntry";
import { slugifyStr } from "@/utils/slugify";
import { tagLabel } from "@/utils/tagMeta";
import tagsVocabulary from "@/data/tags.json";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import IntroAudio from "@/components/IntroAudio.astro";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import "dayjs/locale/fr";

dayjs.extend(utc);
dayjs.extend(timezone);

const [blogPosts, galleryPosts] = await Promise.all([
  getCollection("blog"),
  SITE.showGalleries && SITE.showGalleriesInIndex
    ? getCollection("galleries")
    : Promise.resolve([]),
]);
const posts = [...blogPosts, ...galleryPosts];

const sortedPosts = getSortedPosts(posts);
const isFeatured = (p: (typeof sortedPosts)[number]) =>
  "featured" in p.data && Boolean(p.data.featured);
const featuredPosts = sortedPosts.filter(isFeatured);
const nonFeatured = sortedPosts.filter(p => !isFeatured(p));

// Le dernier article tient lieu de visuel du hero : du vrai contenu plutôt
// qu'une illustration. Il sort donc de la liste « Derniers articles ».
const [latestPost, ...restPosts] = nonFeatured;
const recentPosts = restPosts.slice(0, SITE.postPerIndex);

const entryDate = (data: (typeof sortedPosts)[number]["data"]) => {
  const mod = "modDatetime" in data ? data.modDatetime : null;
  const d = mod && dayjs(mod).isAfter(data.pubDatetime) ? mod : data.pubDatetime;
  return dayjs(d).tz(SITE.timezone).locale("fr");
};

// Thèmes = tags primaires du vocabulaire fermé, avec leur nombre d'articles.
const tagCounts = new Map<string, number>();
for (const p of blogPosts) {
  if (p.data.draft) continue;
  for (const t of p.data.tags) {
    const slug = slugifyStr(t);
    tagCounts.set(slug, (tagCounts.get(slug) ?? 0) + 1);
  }
}
const themes = tagsVocabulary.primary
  .map(slug => ({
    slug,
    label: tagLabel(slug),
    count: tagCounts.get(slug) ?? 0,
  }))
  .filter(t => t.count > 0)
  .sort((a, b) => b.count - a.count);

const totalPosts = blogPosts.filter(p => !p.data.draft).length;
---

<Layout>
  <Header />

  <main id="main-content" data-layout="index" class="relative app-layout">
    <!-- Hero : identité à gauche, dernier article à droite -->
    <section
      id="hero"
      class="grid gap-10 pt-10 pb-16 sm:pt-16 lg:grid-cols-12 lg:gap-12 lg:pt-20 lg:pb-24"
    >
      <div class="flex flex-col justify-center lg:col-span-7">
        <p class="label-mono reveal mb-5" style="--i:0">
          <span class="text-accent">{SITE.heroTerminalPrompt.prefix}</span>
          {SITE.heroTerminalPrompt.branch && (
            <span> git:({SITE.heroTerminalPrompt.branch})</span>
          )}
          <span> {SITE.heroTerminalPrompt.suffix}</span>
        </p>

        <h1
          class="reveal text-5xl leading-[1.02] font-semibold tracking-[-0.035em] sm:text-6xl lg:text-[4.25rem]"
          style="--i:1"
        >
          {SITE.title}
        </h1>

        <p
          class="reveal mt-6 max-w-[34rem] text-lg leading-relaxed text-soft"
          style="--i:2"
        >
          Guides concrets sur le homelab, l'auto-hébergement et Linux, pour
          reprendre le contrôle de tes données.
        </p>

        <div
          class="reveal mt-8 flex flex-wrap items-center gap-x-6 gap-y-4"
          style="--i:3"
        >
          <a href="/blog/" class="hero-cta">
            Lire les articles
            <IconArrowRight class="size-4" aria-hidden="true" />
          </a>
          <a href="/rss.xml" class="link-arrow text-sm" target="_blank">
            <IconRss class="size-4" aria-hidden="true" />
            Flux RSS
          </a>
          {
            SITE.introAudio.enabled && (
              <IntroAudio
                src={SITE.introAudio.src}
                label={SITE.introAudio.label}
                duration={SITE.introAudio.duration}
                isStream={SITE.introAudio.isStream}
              />
            )
          }
        </div>
      </div>

      {
        latestPost && (
          <a
            href={getEntryPath(latestPost)}
            class="latest-card reveal group lg:col-span-5"
            style="--i:2"
          >
            <span class="label-mono">Dernier article</span>
            <h2 class="mt-auto pt-10 text-2xl leading-tight font-semibold tracking-[-0.02em] transition-colors duration-200 group-hover:text-accent sm:text-[1.75rem]">
              {latestPost.data.title}
            </h2>
            <p class="mt-3 line-clamp-3 text-[0.95rem] leading-relaxed text-soft">
              {latestPost.data.description}
            </p>
            <span class="mt-6 flex items-center justify-between text-sm">
              <time
                class="font-mono text-soft"
                datetime={entryDate(latestPost.data).toISOString()}
              >
                {entryDate(latestPost.data).format("D MMMM YYYY")}
              </time>
              <span class="link-arrow">
                Lire
                <IconArrowRight class="size-4" aria-hidden="true" />
              </span>
            </span>
          </a>
        )
      }
    </section>

    <!-- À la une : bento asymétrique, une cellule par article -->
    {
      featuredPosts.length > 0 && (
        <section id="featured" class="pb-20" aria-labelledby="featured-title">
          <h2
            id="featured-title"
            class="mb-8 text-2xl font-semibold tracking-[-0.02em] sm:text-3xl"
          >
            À la une
          </h2>
          <ul class="featured-grid">
            {featuredPosts.map((post, i) => (
              <li class:list={["featured-cell", `featured-cell--${Math.min(i, 3)}`]}>
                <a href={getEntryPath(post)} class="group flex h-full flex-col">
                  <h3 class="featured-title transition-colors duration-200 group-hover:text-accent">
                    {post.data.title}
                  </h3>
                  <p class="featured-desc">{post.data.description}</p>
                  <time
                    class="mt-auto pt-5 font-mono text-xs text-soft"
                    datetime={entryDate(post.data).toISOString()}
                  >
                    {entryDate(post.data).format("D MMM YYYY")}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- Thèmes : les tags primaires, triés par volume -->
    {
      themes.length > 0 && (
        <section id="themes" class="pb-20" aria-labelledby="themes-title">
          <h2
            id="themes-title"
            class="mb-6 text-2xl font-semibold tracking-[-0.02em] sm:text-3xl"
          >
            Par thème
          </h2>
          <ul class="flex flex-wrap gap-x-7 gap-y-3">
            {themes.map(t => (
              <li>
                <a href={`/tags/${t.slug}/`} class="theme-link group">
                  <span class="text-xl font-medium tracking-[-0.01em] transition-colors duration-200 group-hover:text-accent sm:text-2xl">
                    {t.label}
                  </span>
                  <sup class="ml-1 font-mono text-xs text-soft">{t.count}</sup>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- Derniers articles : liste éditoriale, date en colonne -->
    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pb-20" aria-labelledby="recent-title">
          <h2
            id="recent-title"
            class="mb-4 text-2xl font-semibold tracking-[-0.02em] sm:text-3xl"
          >
            Derniers articles
          </h2>
          <ol class="recent-list">
            {recentPosts.map(post => (
              <li>
                <a href={getEntryPath(post)} class="recent-row group">
                  <time
                    class="font-mono text-xs text-soft sm:pt-1.5"
                    datetime={entryDate(post.data).toISOString()}
                  >
                    {entryDate(post.data).format("DD.MM.YYYY")}
                  </time>
                  <span>
                    <span class="block text-lg leading-snug font-semibold tracking-[-0.01em] transition-colors duration-200 group-hover:text-accent">
                      {post.data.title}
                    </span>
                    <span class="mt-1.5 line-clamp-2 block text-[0.95rem] leading-relaxed text-soft">
                      {post.data.description}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ol>

          <a href="/blog/" class="link-arrow mt-8">
            Tous les articles ({totalPosts})
            <IconArrowRight class="size-4" aria-hidden="true" />
          </a>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-box);
    background: var(--accent);
    color: var(--background);
    font-weight: 600;
    white-space: nowrap;
    transition:
      transform 0.25s var(--ease-out-soft),
      background-color 0.2s ease;
  }

  .hero-cta:hover {
    background: color-mix(in srgb, var(--accent) 88%, var(--foreground));
  }

  .hero-cta:hover :global(svg) {
    transform: translateX(3px);
  }

  .hero-cta :global(svg) {
    transition: transform 0.3s var(--ease-out-soft);
  }

  .hero-cta:active {
    transform: translateY(1px) scale(0.99);
  }

  .latest-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 20rem;
    padding: 1.75rem;
    border-radius: var(--radius-box);
    border: 1px solid var(--border);
    background:
      radial-gradient(
        120% 90% at 100% 0%,
        color-mix(in srgb, var(--accent) 16%, transparent) 0%,
        transparent 60%
      ),
      var(--surface);
    box-shadow: 0 24px 48px -32px hsl(var(--shadow-tint) / 0.35);
    transition:
      border-color 0.25s ease,
      transform 0.35s var(--ease-out-soft);
  }

  .latest-card:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
    transform: translateY(-2px);
  }

  .latest-card:active {
    transform: translateY(0);
  }

  /* ── Bento « À la une » ──
   * lg : 3 colonnes. Cellule 0 = 2×2 teintée, 1 et 2 empilées à droite sur
   * fond surface, les suivantes en rangée sous un simple filet. Avec 6 articles
   * la grille est pleine (2×2 + 2 + 3). */
  .featured-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .featured-cell--0 {
      grid-column: span 2;
    }
  }

  @media (min-width: 1024px) {
    .featured-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-flow: dense;
    }
    .featured-cell--0 {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  .featured-cell {
    border-radius: var(--radius-box);
    padding: 1.5rem;
    transition: border-color 0.25s ease;
  }

  .featured-cell--0 {
    padding: 2rem;
    border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--border));
    background:
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--accent) 14%, var(--surface)) 0%,
        var(--surface) 70%
      );
  }

  .featured-cell--1,
  .featured-cell--2 {
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .featured-cell--3 {
    padding-inline: 0;
    border-top: 1px solid var(--border);
    border-radius: 0;
  }

  .featured-cell--0:hover,
  .featured-cell--1:hover,
  .featured-cell--2:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
  }

  .featured-title {
    font-size: 1.125rem;
    line-height: 1.35;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .featured-cell--0 .featured-title {
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .featured-desc {
    margin-top: 0.625rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Grande cellule : date en tête, titre ancré en bas, comme une couverture. */
  .featured-cell--0 time {
    order: -1;
    margin-top: 0;
    padding-top: 0;
    margin-bottom: auto;
  }

  .featured-cell--0 .featured-title {
    padding-top: 3rem;
  }

  .featured-cell--0 .featured-desc {
    font-size: 1.0625rem;
    max-width: 36rem;
  }

  /* ── Liste « Derniers articles » ── */
  .recent-list > li + li {
    border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
  }

  .recent-row {
    display: grid;
    gap: 0.375rem;
    padding-block: 1.25rem;
  }

  @media (min-width: 640px) {
    .recent-row {
      grid-template-columns: 7.5rem 1fr;
      gap: 1.5rem;
    }
  }

  .recent-row:active {
    transform: translateY(1px);
  }

  .theme-link:active {
    transform: translateY(1px);
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
