---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import tagsVocabulary from "@/data/tags.json";
import { tagLabel } from "@/utils/tagMeta";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { SITE } from "@/config";

const [blogPosts, galleryPosts] = await Promise.all([
  getCollection("blog"),
  SITE.showGalleries && SITE.showGalleriesInIndex
    ? getCollection("galleries")
    : Promise.resolve([]),
]);
const posts = [...blogPosts, ...galleryPosts];

const tags = getUniqueTags(posts);
const tagsWithCount = tags.map(({ tag, tagName }) => ({
  tag,
  tagName,
  count: getPostsByTag(posts, tag).length,
}));

const META_TAGS = ["guide", "debutant", "intermediaire", "avance"];
const displayTags = tagsWithCount.filter(({ tag }) => !META_TAGS.includes(tag));
const byCount = (a: { count: number }, b: { count: number }) => b.count - a.count;
const primarySet = new Set<string>(tagsVocabulary.primary);
const primaryTags = displayTags.filter(t => primarySet.has(t.tag)).sort(byCount);
const otherTags = displayTags.filter(t => !primarySet.has(t.tag)).sort(byCount);
---

<Layout
  title={`Tags : Sujets du blog | ${SITE.title}`}
  description="Explorez tous les sujets du blog Brandon Visca : homelab, auto-hébergement, Linux, macOS, sécurité, Docker et bien plus.">
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-16">
    <div class="pt-6 pb-12">
      <h1 class="text-4xl font-semibold tracking-[-0.03em] sm:text-5xl">Tags</h1>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-soft">
        Tous les sujets du blog, du plus couvert au plus pointu.
      </p>
      <p class="mt-4 font-mono text-xs text-soft tabular">
        {displayTags.length} tags, {posts.length} articles
      </p>
    </div>

    <section aria-labelledby="primary-tags-title" class="mb-16">
      <h2 id="primary-tags-title" class="mb-6 text-2xl font-semibold tracking-[-0.02em]">
        Thèmes principaux
      </h2>
      <ul class="primary-grid">
        {
          primaryTags.map(({ tag, count }) => (
            <li>
              <a href={`/tags/${tag}/`} transition:name={tag} class="primary-tag group">
                <span class="text-xl font-medium tracking-[-0.01em] transition-colors duration-200 group-hover:text-accent">
                  {tagLabel(tag)}
                </span>
                <span class="font-mono text-xs text-soft tabular">
                  {count} {count === 1 ? "article" : "articles"}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      otherTags.length > 0 && (
        <section aria-labelledby="other-tags-title">
          <h2 id="other-tags-title" class="mb-6 text-2xl font-semibold tracking-[-0.02em]">
            Autres sujets
          </h2>
          <ul class="flex flex-wrap gap-x-6 gap-y-3">
            {otherTags.map(({ tag, tagName, count }) => (
              <li>
                <a href={`/tags/${tag}/`} transition:name={tag} class="group inline-flex items-baseline gap-1.5">
                  <span class="text-base transition-colors duration-200 group-hover:text-accent">#{tagName}</span>
                  <span class="font-mono text-xs text-soft tabular">{count}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  .primary-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 2rem;
  }

  @media (min-width: 640px) {
    .primary-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .primary-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .primary-tag {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    border-top: 1px solid var(--border);
  }

  .primary-tag:active {
    transform: translateY(1px);
  }
</style>
